\f0\fs24 \cf0 * \{\
    box-sizing: border-box;\
    margin: 0;\
    padding: 0;\
\}\
\
:root \{\
    --green: #087a3d;\
    --dark-green: #04351e;\
    --light-green: #19a85b;\
    --gold: #ffd54a;\
    --red: #e63946;\
    --white: #ffffff;\
    --dark: #07110c;\
\}\
\
body \{\
    font-family: Arial, Helvetica, sans-serif;\
    background: #06130b;\
    color: white;\
    overflow: hidden;\
\}\
\
/* =========================\
   GENERAL SCREENS\
========================= */\
\
.screen \{\
    width: 100vw;\
    height: 100vh;\
    position: relative;\
\}\
\
.hidden \{\
    display: none !important;\
\}\
\
\
/* =========================\
   HOME\
========================= */\
\
#homeScreen \{\
    display: flex;\
    justify-content: center;\
    align-items: center;\
\
    background:\
        radial-gradient(circle at 50% 20%, #145d35 0%, transparent 45%),\
        linear-gradient(135deg, #031c0e, #06130b 60%, #021008);\
\}\
\
.home-card \{\
    width: min(700px, 92vw);\
    padding: 50px;\
    text-align: center;\
\
    background: rgba(5, 25, 15, 0.94);\
    border: 1px solid rgba(255,255,255,0.12);\
    border-radius: 25px;\
\
    box-shadow:\
        0 30px 80px rgba(0,0,0,0.6),\
        inset 0 1px rgba(255,255,255,0.05);\
\}\
\
.badge \{\
    display: inline-block;\
    background: var(--gold);\
    color: #111;\
    padding: 7px 14px;\
    border-radius: 30px;\
    font-size: 12px;\
    font-weight: bold;\
    letter-spacing: 1px;\
\}\
\
.home-card h1 \{\
    margin-top: 20px;\
    font-size: clamp(45px, 8vw, 80px);\
    line-height: 0.95;\
\}\
\
.subtitle \{\
    margin: 25px auto;\
    max-width: 550px;\
    color: #b8c8bf;\
    font-size: 18px;\
    line-height: 1.5;\
\}\
\
.feature-grid \{\
    display: grid;\
    grid-template-columns: repeat(4, 1fr);\
    gap: 10px;\
    margin: 30px 0;\
\}\
\
.feature-grid div \{\
    padding: 15px 5px;\
    background: rgba(255,255,255,0.04);\
    border-radius: 12px;\
\}\
\
.feature-grid strong \{\
    display: block;\
    font-size: 25px;\
    margin-bottom: 7px;\
\}\
\
.feature-grid span \{\
    font-size: 11px;\
    color: #b8c8bf;\
\}\
\
.main-button \{\
    border: none;\
    background: var(--gold);\
    color: #111;\
    padding: 16px 35px;\
    border-radius: 12px;\
    font-size: 16px;\
    font-weight: 900;\
    cursor: pointer;\
    transition: 0.15s;\
\}\
\
.main-button:hover \{\
    transform: translateY(-2px);\
    background: #ffe27b;\
    box-shadow: 0 8px 25px rgba(255,213,74,0.2);\
\}\
\
.controls-preview \{\
    margin-top: 20px;\
    font-size: 11px;\
    color: #718278;\
\}\
\
\
/* =========================\
   QUESTIONS\
========================= */\
\
#questionScreen \{\
    overflow-y: auto;\
\
    background:\
        radial-gradient(circle at top, #124e2d, transparent 50%),\
        #06130b;\
\}\
\
.question-container \{\
    width: min(850px, 94vw);\
    margin: auto;\
    padding: 40px 0 70px;\
\}\
\
.top-bar \{\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    margin-bottom: 25px;\
\}\
\
.small-label \{\
    display: block;\
    color: #6f9b82;\
    font-size: 11px;\
    letter-spacing: 2px;\
    font-weight: bold;\
\}\
\
#questionNumber \{\
    display: block;\
    margin-top: 4px;\
    font-weight: bold;\
\}\
\
#questionScore \{\
    color: var(--gold);\
    font-weight: bold;\
\}\
\
.topic-pill \{\
    display: inline-block;\
    padding: 7px 13px;\
    border-radius: 20px;\
    background: rgba(25,168,91,0.2);\
    color: #55d991;\
    font-size: 12px;\
    font-weight: bold;\
    margin-bottom: 12px;\
\}\
\
.question-card \{\
    background: rgba(10,30,19,0.95);\
    border: 1px solid rgba(255,255,255,0.08);\
    border-radius: 20px;\
    padding: 35px;\
\}\
\
.marks \{\
    color: var(--gold);\
    font-size: 12px;\
    font-weight: bold;\
    margin-bottom: 15px;\
\}\
\
.question-card h2 \{\
    font-size: clamp(22px, 4vw, 32px);\
    line-height: 1.3;\
    margin-bottom: 30px;\
\}\
\
.answer-area \{\
    display: grid;\
    gap: 12px;\
    margin-bottom: 25px;\
\}\
\
.answer-option \{\
    width: 100%;\
    padding: 16px;\
    text-align: left;\
    border-radius: 12px;\
    border: 1px solid #274332;\
    background: #0b2114;\
    color: white;\
    cursor: pointer;\
    font-size: 15px;\
    transition: 0.15s;\
\}\
\
.answer-option:hover \{\
    border-color: #50c87d;\
    background: #10351f;\
\}\
\
.answer-option.selected \{\
    border-color: var(--gold);\
    background: rgba(255,213,74,0.12);\
\}\
\
.answer-option.correct \{\
    border-color: #3de27d;\
    background: rgba(61,226,125,0.15);\
\}\
\
.answer-option.incorrect \{\
    border-color: #ef5963;\
    background: rgba(239,89,99,0.15);\
\}\
\
.feedback \{\
    margin-top: 20px;\
    padding: 15px;\
    border-radius: 10px;\
    line-height: 1.5;\
    font-size: 14px;\
\}\
\
.feedback.correct-feedback \{\
    background: rgba(61,226,125,0.12);\
    border: 1px solid #3de27d;\
    color: #86efac;\
\}\
\
.feedback.wrong-feedback \{\
    background: rgba(239,89,99,0.12);\
    border: 1px solid #ef5963;\
    color: #ff9aa1;\
\}\
\
\
/* =========================\
   AFL GAME\
========================= */\
\
#aflScreen \{\
    background: #102a18;\
\}\
\
/* HUD */\
\
#gameHUD \{\
    position: absolute;\
    top: 15px;\
    left: 15px;\
    right: 15px;\
\
    display: flex;\
    justify-content: space-between;\
\
    z-index: 20;\
    pointer-events: none;\
\}\
\
.hud-box \{\
    background: rgba(0,0,0,0.65);\
    border: 1px solid rgba(255,255,255,0.12);\
    padding: 10px 16px;\
    border-radius: 10px;\
    min-width: 100px;\
\}\
\
.hud-box span \{\
    display: block;\
    color: #91a89a;\
    font-size: 9px;\
    letter-spacing: 1px;\
\}\
\
.hud-box strong \{\
    display: block;\
    margin-top: 3px;\
    font-size: 18px;\
\}\
\
\
/* FIELD */\
\
#field \{\
    position: absolute;\
\
    width: min(92vw, 1500px);\
    height: min(78vh, 850px);\
\
    left: 50%;\
    top: 52%;\
\
    transform: translate(-50%, -50%);\
\
    overflow: hidden;\
\
    border-radius: 48%;\
\
    background:\
        repeating-linear-gradient(\
            90deg,\
            rgba(255,255,255,0.025) 0px,\
            rgba(255,255,255,0.025) 50px,\
            transparent 50px,\
            transparent 100px\
        ),\
        linear-gradient(\
            90deg,\
            #147b3e,\
            #1a9149,\
            #147b3e\
        );\
\
    border: 7px solid #e8e8e8;\
\
    box-shadow:\
        inset 0 0 100px rgba(0,0,0,0.25),\
        0 25px 60px rgba(0,0,0,0.5);\
\}\
\
\
/* Field markings */\
\
#field::before \{\
    content: "";\
    position: absolute;\
    inset: 9%;\
    border: 3px solid rgba(255,255,255,0.8);\
    border-radius: 50%;\
\}\
\
.centre-circle \{\
    position: absolute;\
    width: 160px;\
    height: 160px;\
    border: 3px solid rgba(255,255,255,0.75);\
    border-radius: 50%;\
    left: 50%;\
    top: 50%;\
    transform: translate(-50%, -50%);\
\}\
\
.centre-line \{\
    position: absolute;\
    width: 3px;\
    height: 100%;\
    left: 50%;\
    top: 0;\
    background: rgba(255,255,255,0.5);\
\}\
\
.goal-square \{\
    position: absolute;\
    width: 15%;\
    height: 45%;\
    top: 27.5%;\
    border: 3px solid rgba(255,255,255,0.8);\
\}\
\
.goal-square.left \{\
    left: 5%;\
\}\
\
.goal-square.right \{\
    right: 5%;\
\}\
\
.goal-post \{\
    position: absolute;\
    width: 7px;\
    height: 55px;\
    background: white;\
    border-radius: 5px;\
    top: 50%;\
    transform: translateY(-50%);\
\}\
\
.post-1 \{\
    left: 1%;\
\}\
\
.post-2 \{\
    left: 3%;\
\}\
\
.post-3 \{\
    right: 1%;\
\}\
\
.post-4 \{\
    right: 3%;\
\}\
\
\
/* Players */\
\
.player,\
.defender,\
.teammate \{\
    position: absolute;\
\
    width: 32px;\
    height: 32px;\
\
    border-radius: 50%;\
\
    display: flex;\
    align-items: center;\
    justify-content: center;\
\
    font-size: 10px;\
    font-weight: bold;\
\
    z-index: 8;\
\
    transition:\
        left 0.08s linear,\
        top 0.08s linear;\
\}\
\
.player \{\
    background: #071bff;\
    border: 3px solid white;\
    box-shadow: 0 0 15px rgba(40,80,255,0.8);\
\}\
\
.player::after \{\
    content: "";\
    position: absolute;\
    width: 42px;\
    height: 42px;\
    border: 1px solid rgba(255,255,255,0.4);\
    border-radius: 50%;\
\}\
\
.defender \{\
    background: #d71920;\
    border: 3px solid white;\
    box-shadow: 0 0 10px rgba(215,25,32,0.6);\
\}\
\
.teammate \{\
    background: #1455ff;\
    border: 2px solid #9eb4ff;\
\}\
\
.player-number \{\
    font-size: 9px;\
\}\
\
.ball \{\
    position: absolute;\
\
    width: 13px;\
    height: 19px;\
\
    background: #6b3519;\
\
    border-radius: 50%;\
\
    transform: rotate(25deg);\
\
    z-index: 10;\
\
    box-shadow: 0 2px 5px rgba(0,0,0,0.4);\
\}\
\
\
/* Aim */\
\
#aimIndicator \{\
    position: absolute;\
    width: 100px;\
    height: 3px;\
    background: rgba(255,213,74,0.8);\
\
    transform-origin: left center;\
\
    z-index: 5;\
\
    pointer-events: none;\
\}\
\
\
/* Messages */\
\
#actionMessage \{\
    position: absolute;\
    left: 50%;\
    top: 15%;\
    transform: translateX(-50%);\
\
    font-size: 25px;\
    font-weight: 900;\
\
    text-shadow: 0 3px 10px rgba(0,0,0,0.7);\
\
    pointer-events: none;\
\
    opacity: 0;\
\}\
\
#actionMessage.show \{\
    animation: messageAnimation 1.2s ease forwards;\
\}\
\
@keyframes messageAnimation \{\
    0% \{\
        opacity: 0;\
        transform: translate(-50%, 20px);\
    \}\
\
    20% \{\
        opacity: 1;\
        transform: translate(-50%, 0);\
    \}\
\
    75% \{\
        opacity: 1;\
    \}\
\
    100% \{\
        opacity: 0;\
        transform: translate(-50%, -30px);\
    \}\
\}\
\
\
/* Controls */\
\
#controls \{\
    position: absolute;\
\
    bottom: 15px;\
    left: 50%;\
\
    transform: translateX(-50%);\
\
    display: flex;\
    gap: 10px;\
\
    padding: 10px 15px;\
\
    background: rgba(0,0,0,0.7);\
    border-radius: 12px;\
\
    z-index: 30;\
\}\
\
.control-group \{\
    display: flex;\
    align-items: center;\
    gap: 5px;\
\
    color: #a9b9af;\
\
    font-size: 10px;\
\}\
\
kbd \{\
    padding: 5px 7px;\
    background: #1a261e;\
    border: 1px solid #45534a;\
    border-radius: 5px;\
    color: white;\
    font-weight: bold;\
\}\
\
\
/* Play result */\
\
#playResult \{\
    position: absolute;\
    inset: 0;\
\
    display: flex;\
    justify-content: center;\
    align-items: center;\
\
    background: rgba(0,0,0,0.55);\
\
    z-index: 100;\
\}\
\
.result-card \{\
    width: min(500px, 90vw);\
    padding: 35px;\
    text-align: center;\
\
    background: #07180e;\
    border: 1px solid rgba(255,255,255,0.15);\
    border-radius: 20px;\
\
    box-shadow: 0 20px 60px rgba(0,0,0,0.7);\
\}\
\
.result-card h2 \{\
    margin-bottom: 15px;\
\}\
\
.result-card p \{\
    color: #b6c4ba;\
    line-height: 1.5;\
    margin-bottom: 25px;\
\}\
\
\
/* =========================\
   GAME OVER\
========================= */\
\
#gameOverScreen \{\
    display: flex;\
    align-items: center;\
    justify-content: center;\
\
    background:\
        radial-gradient(circle at center, #145d35, transparent 55%),\
        #06130b;\
\}\
\
.game-over-card \{\
    width: min(650px, 90vw);\
    text-align: center;\
    padding: 45px;\
\
    background: rgba(7,24,14,0.96);\
\
    border-radius: 25px;\
    border: 1px solid rgba(255,255,255,0.1);\
\}\
\
.game-over-card h1 \{\
    font-size: 50px;\
    margin: 20px 0;\
\}\
\
.final-score \{\
    font-size: 80px;\
    color: var(--gold);\
    font-weight: 900;\
\}\
\
.stats \{\
    display: grid;\
    grid-template-columns: repeat(3, 1fr);\
    gap: 10px;\
    margin: 30px 0;\
\}\
\
.stats div \{\
    padding: 18px 5px;\
    background: rgba(255,255,255,0.04);\
    border-radius: 10px;\
\}\
\
.stats span \{\
    display: block;\
    color: #788c7e;\
    font-size: 11px;\
\}\
\
.stats strong \{\
    display: block;\
    margin-top: 7px;\
    font-size: 22px;\
\}\
\
\
/* =========================\
   MOBILE\
========================= */\
\
@media (max-width: 700px) \{\
\
    .home-card \{\
        padding: 30px 20px;\
    \}\
\
    .feature-grid \{\
        grid-template-columns: repeat(2, 1fr);\
    \}\
\
    .question-container \{\
        padding-top: 20px;\
    \}\
\
    .question-card \{\
        padding: 22px;\
    \}\
\
    #controls \{\
        width: 95vw;\
        overflow-x: auto;\
        justify-content: flex-start;\
    \}\
\
    .control-group \{\
        flex-shrink: 0;\
    \}\
\
    .stats \{\
        grid-template-columns: 1fr;\
    \}\
\
    #field \{\
        width: 96vw;\
        height: 70vh;\
    \}\
\}}