/* =========================================================\
   PLAYER MOVEMENT\
========================================================= */\
\
function updatePlayer() \{\
\
    if (!gameRunning || !hasBall) return;\
\
    let speed = player.speed;\
\
    if (keys["shift"]) \{\
        speed *= 1.8;\
    \}\
\
    if (keys["w"]) \{\
        player.y -= speed;\
    \}\
\
    if (keys["s"]) \{\
        player.y += speed;\
    \}\
\
    if (keys["a"]) \{\
        player.x -= speed;\
    \}\
\
    if (keys["d"]) \{\
        player.x += speed;\
    \}\
\
    player.x = Math.max(8, Math.min(92, player.x));\
\
    player.y = Math.max(8, Math.min(92, player.y));\
\
\}\
\
\
/* =========================================================\
   DEFENDER AI\
========================================================= */\
\
function updateDefenders() \{\
\
    if (!gameRunning) return;\
\
    defenders.forEach(defender => \{\
\
        const dx = player.x - defender.x;\
        const dy = player.y - defender.y;\
\
        const distance =\
            Math.sqrt(dx * dx + dy * dy);\
\
        if (distance > 4) \{\
\
            defender.x +=\
                (dx / distance) *\
                defender.speed;\
\
            defender.y +=\
                (dy / distance) *\
                defender.speed;\
\
        \}\
\
    \});\
\
\}\
\
\
/* =========================================================\
   TEAMMATES\
========================================================= */\
\
function updateTeammates() \{\
\
    teammates[0].x =\
        38 + Math.sin(Date.now() / 1500) * 4;\
\
    teammates[0].y =\
        38 + Math.cos(Date.now() / 1200) * 5;\
\
    teammates[1].x =\
        42 + Math.cos(Date.now() / 1700) * 5;\
\
    teammates[1].y =\
        68 + Math.sin(Date.now() / 1300) * 4;\
\
\}\
\
\
/* =========================================================\
   DRAW GAME\
========================================================= */\
