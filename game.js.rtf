function startClock() \{\
\
    clearInterval(clockInterval);\
\
    clockInterval = setInterval(() => \{\
\
        if (!gameRunning) return;\
\
        gameTime--;\
\
        const seconds =\
            Math.max(0, gameTime);\
\
        gameClock.textContent =\
            `00:$\{String(seconds).padStart(2, "0")\}`;\
\
        if (gameTime <= 0) \{\
\
            finishPlay(\
                false,\
                "The siren sounds. You ran out of time."\
            );\
\
        \}\
\
    \}, 1000);\
\
\}\
