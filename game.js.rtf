/* =========================================================\
   LOAD QUESTION\
========================================================= */\
\
function loadQuestion() \{\
\
    selectedAnswer = null;\
\
    questionFeedback.className = "feedback hidden";\
\
    submitAnswer.disabled = false;\
\
    const q = questions[currentQuestion];\
\
    questionNumber.textContent =\
        `Question $\{currentQuestion + 1\} / $\{questions.length\}`;\
\
    questionTopic.textContent = q.topic;\
\
    questionMarks.textContent =\
        `$\{q.marks\} marks`;\
\
    questionText.textContent =\
        q.question;\
\
    questionScore.textContent =\
        `Correct: $\{entertainmentCorrect\}`;\
\
    answerArea.innerHTML = "";\
\
    q.answers.forEach((answer, index) => \{\
\
        const button = document.createElement("button");\
\
        button.className = "answer-option";\
\
        button.textContent =\
            `$\{String.fromCharCode(65 + index)\}. $\{answer\}`;\
\
        button.addEventListener("click", () => \{\
\
            document\
                .querySelectorAll(".answer-option")\
                .forEach(option => option.classList.remove("selected"));\
\
            button.classList.add("selected");\
\
            selectedAnswer = index;\
\
        \});\
\
        answerArea.appendChild(button);\
\
    \});\
\
\}\
\
\
/* =========================================================\
   SUBMIT ANSWER\
========================================================= */\
\
submitAnswer.addEventListener("click", () => \{\
\
    if (selectedAnswer === null) \{\
        showMessage("Choose an answer first.");\
        return;\
    \}\
\
    const q = questions[currentQuestion];\
\
    entertainmentAttempted++;\
\
    const options =\
        document.querySelectorAll(".answer-option");\
\
    options.forEach((option, index) => \{\
\
        if (index === q.correct) \{\
            option.classList.add("correct");\
        \}\
\
        if (\
            index === selectedAnswer &&\
            selectedAnswer !== q.correct\
        ) \{\
            option.classList.add("incorrect");\
        \}\
\
    \});\
\
    submitAnswer.disabled = true;\
\
    if (selectedAnswer === q.correct) \{\
\
        entertainmentCorrect++;\
\
        questionFeedback.className =\
            "feedback correct-feedback";\
\
        questionFeedback.textContent =\
            `CORRECT! $\{q.explanation\} You earned AFL possession.`;\
\
        questionFeedback.classList.remove("hidden");\
\
        setTimeout(() => \{\
            startAFL();\
        \}, 1300);\
\
    \} else \{\
\
        questionFeedback.className =\
            "feedback wrong-feedback";\
\
        questionFeedback.textContent =\
            `Not quite. $\{q.explanation\} You don't earn possession this time.`;\
\
        questionFeedback.classList.remove("hidden");\
\
        setTimeout(() => \{\
            nextQuestion();\
        \}, 1800);\
\
    \}\
\
\});\
