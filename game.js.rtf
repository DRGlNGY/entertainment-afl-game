        Math.min(\
            ...defenders.map(d =>\
                distanceBetween(player, d)\
            )\
        );\
\
    let success;\
\
    if (leadKick) \{\
\
        success =\
            nearestDefender > 9 &&\
            Math.random() > 0.2;\
\
    \} else \{\
\
        success =\
            nearestDefender > 5 &&\
            Math.random() > 0.3;\
\
    \}\
\
    if (success) \{\
\
        successfulPlays++;\
\
        if (player.x > 82) \{\
\
            aflScore += 6;\
\
            finishPlay(\
                true,\
                "GOAL! You found space inside the forward line and converted."\
            );\
\
        \} else \{\
\
            player.x =\
                Math.min(90, player.x + 12);\
\
            finishPlay(\
                true,\
                leadKick\
                    ? "Lead kick successful! Your teammate gets into space."\
                    : "Good kick! Your team gains territory."\
            );\
\
        \}\
\
    \} else \{\
\
        finishPlay(\
            false,\
            "The kick is intercepted or misses the target."\
        );\
\
    \}\
\
\}\
\
\
/* =========================================================\
   HANDBALL\
========================================================= */\
\
function handball() \{\
\
    if (!gameRunning || !hasBall) return;\
\
    const nearestTeammate =\
        Math.min(\
            ...teammates.map(t =>\
                distanceBetween(player, t)\
            )\
        );\
\
    aflPlays++;\
\
    if (nearestTeammate < 20) \{\
\
        successfulPlays++;\
\
        hasBall = true;\
\
        player.x += 5;\
\
        finishPlay(\
            true,\
            "Handball successful! Your teammate receives it and returns possession."\
        );\
\
    \} else \{\
\
        finishPlay(\
            false,\
            "No teammate was close enough for a safe handball."\
        );\
\
    \}\
\
\}\
\
\
/* =========================================================\
   EVADE\
========================================================= */\
\
function evade() \{\
\
    if (!gameRunning || !hasBall) return;\
\
    const nearestDefender =\
        Math.min(\
            ...defenders.map(d =>\
                distanceBetween(player, d)\
            )\
        );\
\
    if (nearestDefender < 15) \{\
\
        const direction =\
            Math.random() > 0.5 ? 1 : -1;\
\
        player.y +=\
            direction * 12;\
\
        player.x += 6;\
\
        successfulPlays++;\
\
        showMessage("EVASION!");\
\
    \} else \{\
\
        player.x += 5;\
\
        showMessage("BURST!");\
\
    \}\
\
\}\
\
\
/* =========================================================\
   FINISH PLAY\
========================================================= */\
\
function finishPlay(success, message) \{\
\
    gameRunning = false;\
\
    clearInterval(clockInterval);\
\
    if (success) \{\
\
        playResultTitle.textContent =\
            "PLAY SUCCESSFUL!";\
\
    \} else \{\
\
        playResultTitle.textContent =\
            "PLAY ENDED";\
\
    \}\
\
    playResultText.textContent =\
        message;\
\
    aflScoreElement.textContent =\
        aflScore;\
\
    playResult.classList.remove("hidden");\
\
\}\
\
\
/* =========================================================\
   CONTINUE\
========================================================= */\
\
continueButton.addEventListener("click", () => \{\
\
    playResult.classList.add("hidden");\
\
    nextQuestion();\
\
\});\
\
\
/* =========================================================\
   MESSAGE\
========================================================= */\
\
function showMessage(message) \{\
\
    actionMessage.textContent =\
        message;\
\
    actionMessage.classList.remove("show");\
\
    void actionMessage.offsetWidth;\
\
    actionMessage.classList.add("show");\
\
\}\
\
\
/* =========================================================\
   END GAME\
========================================================= */\
\
function endGame() \{\
\
    clearInterval(clockInterval);\
\
    gameRunning = false;\
\
    aflScreen.classList.add("hidden");\
\
    questionScreen.classList.add("hidden");\
\
    gameOverScreen.classList.remove("hidden");\
\
    const percentage =\
        entertainmentAttempted === 0\
            ? 0\
            : Math.round(\
                (entertainmentCorrect /\
                entertainmentAttempted) * 100\
            );\
\
    entertainmentScoreElement.textContent =\
        `$\{percentage\}%`;\
\
    playsScoreElement.textContent =\
        aflPlays;\
\
    successfulPlaysElement.textContent =\
        successfulPlays;\
\
    finalScoreElement.textContent =\
        aflScore;\
\
\}\
\
\
/* =========================================================\
   RESTART\
========================================================= */\
\
restartButton.addEventListener("click", () => \{\
\
    currentQuestion = 0;\
\
    entertainmentCorrect = 0;\
    entertainmentAttempted = 0;\
\
    aflScore = 0;\
    aflPlays = 0;\
    successfulPlays = 0;\
\
    gameTime = 25;\
\
    gameOverScreen.classList.add("hidden");\
\
    questionScreen.classList.remove("hidden");\
\
    loadQuestion();\
\
\});}